{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { 
      "src": "/(.*)\\.(png|ico|json|html|css|js|ts|map|txt|pluto|launcher)$",
      "dest": "/$1.$2"
    },
    {
       "src": "/(.*)",
       "dest": "/api/index.php"
    }
  ]
}
